parameters:
    level: max
    phpVersion:
        min: 80100
        max: 80499
    paths:
        - src
        - tests
    scanFiles:
        - tests/Fixtures/ExternalGroupedAliasedPhpDocModel.php.inc
        - tests/Fixtures/ExternalGroupedPhpDocModel.php.inc
    ignoreErrors:
        - identifier: parameter.defaultValue
        - identifier: trait.unused
        - identifier: property.onlyWritten
        - identifier: isset.property

    reportUnmatchedIgnoredErrors: false
