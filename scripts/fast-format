#!/usr/bin/env bash

set -euo pipefail

cd -- "$(dirname -- "$0")/.."

if [ $# -eq 0 ]; then
    echo "Usage: $0 <file-with-paths>"
    echo "The file should contain one file path per line"
    exit 1
fi

echo "==> Running php-cs-fixer"
xargs -- ./vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --path-mode=intersection -- < "$1"
